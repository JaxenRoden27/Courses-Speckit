# Deploy rewrites User and WorkingDirectory from GitHub secrets.
# BACKEND_DEPLOY_TARGET must be the absolute path to nodeapps/2026/project3/t4.
[Unit]
Description=course-t4 backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/nodeapps/2026/project3/t4
ExecStart=/home/ubuntu/.nvm/versions/node/v18.20.8/bin/node server.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
