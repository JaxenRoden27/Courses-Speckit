DB_HOST=localhost
DB_USER=root
DB_PW=
# Local database. AWS schema is course-t4 (GitHub secret DB_NAME).
DB_NAME=course-t4-db
AUTH_SECRET=change-me-in-production
PORT=3014
NODE_ENV=development
# In development, schema changes auto-apply on server start (set false to disable).
SEQUELIZE_SYNC_ALTER=true
